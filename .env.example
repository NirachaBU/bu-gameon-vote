# คัดลอกเป็น .env.local สำหรับรันในเครื่อง (ห้าม commit ไฟล์ .env.local)
# บน Vercel ให้ใส่ค่าเหล่านี้ใน Settings → Environment Variables

# สุ่มด้วย: npx auth secret   หรือ   openssl rand -base64 32
AUTH_SECRET=

# จาก Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# จาก Neon (Vercel → Storage → Neon จะใส่ให้อัตโนมัติ)
DATABASE_URL=

# จำกัดโดเมนอีเมลที่โหวตได้ คั่นด้วยจุลภาค เช่น bumail.net,bu.ac.th
# ไม่ใส่ = บัญชี Google ไหนก็โหวตได้
ALLOWED_EMAIL_DOMAINS=

# อีเมลผู้จัดที่ดูผลโหวตและพิมพ์ QR ได้ คั่นด้วยจุลภาค
ADMIN_EMAILS=

# ช่วงเวลาเปิดโหวต (ไม่ใส่ = เปิดตลอด) ใส่ +07:00 เพื่อใช้เวลาไทย
VOTE_OPENS_AT=
VOTE_CLOSES_AT=

# ซ่อนผลจากคนทั่วไปช่วงท้าย และเวลาประกาศผล (แอดมินเห็นผลสดตลอด)
# RESULTS_REVEAL_AT = เวลาที่ทุกคนเห็นผลและหน้า /award (ไม่ใส่ = ตอนปิดโหวต)
RESULTS_HIDDEN_AT=
RESULTS_REVEAL_AT=

# โดเมนจริงที่จะใส่ใน QR เช่น https://bu-gameon-vote.vercel.app
# (ไม่ใส่ = ใช้โดเมนที่เปิดหน้า /qr อยู่)
PUBLIC_URL=
